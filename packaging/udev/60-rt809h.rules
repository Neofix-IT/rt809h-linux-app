# RT809H / RT809HSE universal programmer (FTDI FT2232H, 0403:6010, product "RETOOLS ...")
# Grants logged-in users raw USB access; the app detaches ftdi_sio itself.
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0403", ATTR{idProduct}=="6010", ATTR{manufacturer}=="RETOOLS*", MODE="0666", TAG+="uaccess", ENV{ID_RT809H}="1"
